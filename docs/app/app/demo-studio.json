      "isStoreEnforced" : true,
      "name" : "setScoring",
      "title" : "How the studio scores"
    },
    {
      "blurb" : "Tell IPT when your program is in session, so summer and exam weeks do not read as weeks somebody failed to practice. A break is not a miss.",
      "isPurchasable" : true,
